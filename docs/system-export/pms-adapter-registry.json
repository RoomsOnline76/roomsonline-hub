  "adapter_not_allowed_to": {
    "description": "Actions adapters must never perform",
    "rules": [
      "Store PMS credentials in code or logs",
      "Cache availability and use it for booking decisions",
      "Return camelCase field names in data payloads",
      "Modify ROL database directly (only via return values)",
      "Expose raw PMS error messages to end users",
      "Retry failed booking creation automatically",
      "Make booking decisions without live availability check"
    ]
  },
  "adding_new_adapter": {
    "description": "Step-by-step guide for adding a new PMS adapter",
    "steps": [
      {
        "step": 1,
        "title": "Create Edge Function",
        "action": "Create new folder supabase/functions/{pms-name}-api/",
        "files": ["index.ts"]
      },
      {
        "step": 2,
        "title": "Import Contract",
        "action": "Import types and helpers from adapter-contract.ts",
        "code": "import { AdapterResponse, createSuccessResponse, createErrorResponse, ERROR_CODES, ACTIONS } from '../_shared/adapter-contract.ts'"
      },
      {
        "step": 3,
        "title": "Implement Required Actions",
        "action": "Implement at minimum: health_check, fetch_availability, get_room_types",
        "validation": "All responses must pass contract validation"
      },
      {
        "step": 4,
        "title": "Add to System Config",
        "action": "Add entry to src/lib/pmsSystemsConfig.ts",
        "fields": ["key", "name", "description", "isInternal", "hasCustomCard"]
      },
      {
        "step": 5,
        "title": "Add Field Rules",
        "action": "Add rules to src/config/pms-implementation-master.json",
        "sections": ["pms_rules.{pms-name}"]
      },
      {
        "step": 6,
        "title": "Add Credential Support",
        "action": "Define credential requirements in pms_credentials table"
      },
      {
        "step": 7,
        "title": "Add to Booking Flow",
        "action": "Add handler branch in push-booking/index.ts switch statement"
      },
      {
        "step": 8,
        "title": "Add Tracker Entry",
        "action": "Insert row in pms_tracker_status for monitoring"
      },
      {
        "step": 9,
        "title": "Test",
        "action": "Test health_check first, then progressive action testing"
      }
    ]
  }
}
