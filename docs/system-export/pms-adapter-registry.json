{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "schema_version": "1.0.0",
  "export_date": "2025-01-07T00:00:00.000Z",
  "description": "Complete registry of PMS adapters, their capabilities, and integration specifications",
  "adapter_contract": {
    "description": "Mandatory response shape for all PMS adapters",
    "reference_file": "supabase/functions/_shared/adapter-contract.ts",
    "response_shape": {
      "success": {
        "type": "boolean",
        "required": true,
        "description": "Whether the operation succeeded"
      },
      "data": {
        "type": "T | null",
        "required": true,
        "description": "Response payload, null on error"
      },
      "error": {
        "type": "AdapterError | null",
        "required": true,
        "description": "Error details, null on success",
        "shape": {
          "code": "string (from ERROR_CODES)",
          "message": "string",
          "details": "unknown (optional)"
        }
      },
      "source": {
        "type": "PmsSource",
        "required": true,
        "description": "Identifier of the PMS system"
      },
      "fetched_at": {
        "type": "string (ISO8601)",
        "required": true,
        "description": "Timestamp when data was fetched"
      },
      "action": {
        "type": "string",
        "required": true,
        "description": "Action that was performed"
      }
    },
    "naming_convention": {
      "rule": "snake_case",
      "enforcement": "All field names in data payload must use snake_case",
      "rationale": "Consistent parsing and mapping across adapters",
      "examples": {
        "correct": ["room_type_id", "available_units", "check_in_date"],
        "incorrect": ["roomTypeId", "availableUnits", "checkInDate"]
      }
    },
    "helper_functions": {
      "createSuccessResponse": {
        "signature": "<T>(data: T, source: PmsSource, action: string) => AdapterResponse<T>",
        "usage": "Wrap successful responses"
      },
      "createErrorResponse": {
        "signature": "(error: AdapterError, source: PmsSource, action: string) => AdapterResponse<null>",
        "usage": "Wrap error responses"
      }
    }
  },
  "error_codes": {
    "description": "Standardized error codes for all adapters",
    "codes": {
      "INVALID_REQUEST": {
        "description": "Request validation failed",
        "http_equivalent": 400
      },
      "AUTH_FAILED": {
        "description": "Authentication with PMS failed",
        "http_equivalent": 401
      },
      "ACCESS_DENIED": {
        "description": "Insufficient permissions",
        "http_equivalent": 403
      },
      "NOT_FOUND": {
        "description": "Requested resource not found in PMS",
        "http_equivalent": 404
      },
      "AVAILABILITY_CHANGED": {
        "description": "Availability changed during booking attempt",
        "http_equivalent": 409
      },
      "BOOKING_REJECTED": {
        "description": "PMS rejected the booking for business reasons",
        "http_equivalent": 422
      },
      "MODIFICATION_NOT_SUPPORTED": {
        "description": "PMS does not support booking modification",
        "http_equivalent": 501
      },
      "CANCELLATION_NOT_SUPPORTED": {
        "description": "PMS does not support booking cancellation",
        "http_equivalent": 501
      },
      "INTERNAL_ADAPTER_ERROR": {
        "description": "Unexpected error in adapter code",
        "http_equivalent": 500
      },
      "PMS_UNAVAILABLE": {
        "description": "PMS API is unreachable or timing out",
        "http_equivalent": 503
      }
    }
  },
  "standard_actions": {
    "description": "All possible actions an adapter can implement",
    "actions": {
      "health_check": {
        "description": "Verify PMS connectivity and credentials",
        "required": true,
        "request_params": [],
        "response_type": "HealthCheckResponse"
      },
      "get_capabilities": {
        "description": "Return adapter capability flags",
        "required": true,
        "request_params": [],
        "response_type": "CapabilitiesResponse"
      },
      "fetch_availability": {
        "description": "Get live availability for date range",
        "required": true,
        "request_params": ["property_code", "start_date", "end_date", "room_type_id?"],
        "response_type": "AvailabilityResponse"
      },
      "get_room_types": {
        "description": "Get all room types for property",
        "required": true,
        "request_params": ["property_code"],
        "response_type": "RoomTypesResponse"
      },
      "get_rate_types": {
        "description": "Get all rate types for property",
        "required": true,
        "request_params": ["property_code"],
        "response_type": "RateTypesResponse"
      },
      "get_reservations": {
        "description": "Get reservations for date range",
        "required": false,
        "request_params": ["property_code", "start_date", "end_date", "status?"],
        "response_type": "ReservationsResponse"
      },
      "create_reservation": {
        "description": "Create new reservation in PMS",
        "required": false,
        "request_params": ["reservation_payload"],
        "response_type": "CreateReservationResponse"
      },
      "modify_reservation": {
        "description": "Modify existing reservation",
        "required": false,
        "request_params": ["reservation_id", "modifications"],
        "response_type": "ModifyReservationResponse"
      },
      "cancel_reservation": {
        "description": "Cancel existing reservation",
        "required": false,
        "request_params": ["reservation_id", "reason?"],
        "response_type": "CancelReservationResponse"
      },
      "set_availability": {
        "description": "Update availability in PMS",
        "required": false,
        "request_params": ["availability_updates"],
        "response_type": "SetAvailabilityResponse"
      },
      "set_rates": {
        "description": "Update rates in PMS",
        "required": false,
        "request_params": ["rate_updates"],
        "response_type": "SetRatesResponse"
      },
      "fetch_property_data": {
        "description": "Get editorial/property data",
        "required": false,
        "request_params": ["property_code"],
        "response_type": "PropertyDataResponse"
      }
    }
  },
  "adapters": {
    "benson": {
      "name": "Benson",
      "system_key": "benson",
      "edge_function": "supabase/functions/benson-api/index.ts",
      "description": "Full-featured hospitality PMS with comprehensive API",
      "is_internal": false,
      "api_type": "REST",
      "authentication": {
        "type": "API Key + Property Code",
        "credentials_table": "pms_credentials",
        "required_fields": ["api_key", "property_code", "environment"]
      },
      "environments": {
        "staging": {
          "base_url": "https://staging-api.benson.com"
        },
        "production": {
          "base_url": "https://api.benson.com"
        }
      },
      "capabilities": {
        "supports_live_availability": true,
        "supports_rate_fetch": true,
        "supports_create_booking": true,
        "supports_modify_booking": true,
        "supports_cancel_booking": true,
        "supports_webhooks": false
      },
      "implemented_actions": [
        "health_check",
        "get_capabilities",
        "fetch_availability",
        "get_room_types",
        "get_rate_types",
        "get_reservations",
        "create_reservation",
        "fetch_property_data"
      ],
      "field_authority": {
        "reference": "src/config/pms-implementation-master.json#/pms_rules/benson",
        "property_fields": {
          "name": "authoritative",
          "description": "authoritative",
          "address": "authoritative",
          "city": "authoritative",
          "country": "authoritative",
          "latitude": "authoritative",
          "longitude": "authoritative",
          "star_rating": "authoritative",
          "images": "authoritative",
          "amenities": "authoritative",
          "check_in_time": "authoritative",
          "check_out_time": "authoritative"
        },
        "room_types": {
          "cache": true,
          "amenities_seed": true
        }
      },
      "notes": "Primary PMS for ROL. Most complete integration."
    },
    "nightsbridge": {
