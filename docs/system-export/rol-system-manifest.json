        "purpose": "Batch AI editorial content generation",
        "category": "ai"
      },
      {
        "name": "checkfront-api",
        "purpose": "Checkfront PMS adapter",
        "category": "pms_adapter"
      },
      {
        "name": "cloudbeds-api",
        "purpose": "Cloudbeds PMS adapter",
        "category": "pms_adapter"
      },
      {
        "name": "create-user",
        "purpose": "Admin user creation with role assignment",
        "category": "auth"
      },
      {
        "name": "dashboard-insights",
        "purpose": "Analytics and dashboard data aggregation",
        "category": "analytics"
      },
      {
        "name": "editorial-ai-assist",
        "purpose": "AI-assisted property description generation",
        "category": "ai"
      },
      {
        "name": "forgot-password",
        "purpose": "Password reset email trigger",
        "category": "auth"
      },
      {
        "name": "geocode-property",
        "purpose": "Address to coordinates conversion",
        "category": "utility"
      },
      {
        "name": "hostfully-api",
        "purpose": "Hostfully PMS adapter",
        "category": "pms_adapter"
      },
      {
        "name": "hotelbeds-api",
