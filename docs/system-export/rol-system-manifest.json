        "category": "email"
      },
      {
        "name": "send-booking-email",
        "purpose": "Booking confirmation emails",
        "category": "email"
      },
      {
        "name": "send-contact-email",
        "purpose": "Contact form email handler",
        "category": "email"
      },
      {
        "name": "send-pms-status-report",
        "purpose": "PMS integration status reports",
        "category": "email"
      },
      {
        "name": "sync-editorial",
