{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "schema_version": "1.0.0",
  "export_date": "2025-01-07T00:00:00.000Z",
  "system_identity": {
    "system_name": "RoomsOnline (ROL)",
    "system_role": "PMS-agnostic booking orchestration platform",
    "primary_responsibilities": [
      "Multi-room booking creation and management",
      "PMS integration and adapter abstraction",
      "Availability validation and caching",
      "Rate synchronization from external PMS systems",
      "Property management and editorial content",
      "Guest booking flow and payment orchestration"
    ],
    "non_responsibilities": [
      "Acting as source of truth for availability (PMS is authority)",
      "Replacing external PMS systems",
      "Offline booking reconciliation",
      "Direct payment processing (delegated to AddPay/external)",
      "Channel management",
      "Revenue management / dynamic pricing"
    ]
  },
  "architecture": {
    "frontend": {
      "framework": "React 18.3.1",
      "build_tool": "Vite",
      "language": "TypeScript",
      "styling": {
        "primary": "Tailwind CSS",
        "component_library": "shadcn/ui",
        "design_tokens": "CSS custom properties in index.css"
      },
      "state_management": {
        "server_state": "TanStack Query (React Query) v5",
        "client_state": "React Context API",
        "form_state": "React Hook Form + Zod"
      },
      "routing": "React Router DOM v6",
      "key_contexts": [
        {
          "name": "CurrencyContext",
          "purpose": "Global currency selection and formatting"
        },
        {
          "name": "SearchContext",
          "purpose": "Property search state persistence"
        },
        {
          "name": "AISearchContext",
          "purpose": "AI-powered property search state"
        }
      ]
    },
    "backend": {
      "platform": "Supabase (Lovable Cloud)",
      "database": {
        "type": "PostgreSQL",
        "security": "Row Level Security (RLS) on all tables",
        "version": "15.x"
      },
      "authentication": {
        "provider": "Supabase Auth",
        "methods": ["email/password"],
        "auto_confirm": true
      },
      "edge_functions": {
        "runtime": "Deno",
        "deployment": "Automatic via Lovable",
        "count": 26
      }
    },
    "edge_functions_registry": [
