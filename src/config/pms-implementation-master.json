{
  "version": "1.2",
  "description": "RoomsOnline PMS implementation ruleset",
  "pms_rules": [
    {
      "pms": "benson",
      "safe_as_is": true,
      "property_fields": {
        "name": "authoritative",
        "description": "not_available",
        "location": "not_available",
        "images": "not_available"
      },
      "room_types": {
        "cache": "full",
        "amenities_seed": false
      },
      "notes": "Operational PMS only. Do not seed editorial content."
    },
    {
      "pms": "checkfront",
      "safe_as_is": true,
      "property_fields": {
        "name": "authoritative",
        "description": "seed_only",
        "location": "not_available",
        "images": "not_available"
      },
      "room_types": {
        "cache": "full",
        "amenities_seed": "limited"
      },
      "notes": "Descriptions inconsistent. Never overwrite admin content."
    },
    {
      "pms": "hostfully",
      "safe_as_is": true,
      "property_fields": {
        "name": "authoritative",
        "description": "authoritative",
        "location": "authoritative",
        "images": "authoritative",
        "amenities": "partial"
      },
      "room_types": {
        "cache": "full",
        "amenities_seed": true
      },
      "notes": "Best hybrid PMS. Guard amenities mapping."
    },
    {
      "pms": "cloudbeds",
      "safe_as_is": true,
      "property_fields": {
        "name": "authoritative",
        "description": "authoritative",
        "location": "authoritative",
        "geo": "authoritative",
        "images": "authoritative",
        "amenities": "partial"
      },
      "room_types": {
        "cache": "full",
        "amenities_seed": true
      },
      "notes": "Gold standard PMS. Requires disciplined facilities mapping.",
      "overrides": {
        "star_rating": {
          "authoritative": true,
          "ui_locked": true
        }
      }
    },
    {
      "pms": "hyperguest",
      "safe_as_is": true,
      "property_fields": {
        "name": "not_available",
        "description": "not_available",
        "location": "not_available",
        "images": "not_available"
      },
      "room_types": {
        "cache": "full",
        "amenities_seed": false
      },
      "notes": "Distribution channel adapter (PULL model). Routes bookings via HG to OTAs like Booking.com. No editorial content sourced."
    },
    {
      "pms": "little-hotelier",
      "safe_as_is": true,
      "property_fields": {
        "name": "authoritative",
        "description": "authoritative",
        "location": "authoritative",
        "images": "partial"
      },
      "room_types": {
        "cache": "full",
        "amenities_seed": "name_only"
      },
      "notes": "Room images unreliable. Seed text only.",
      "overrides": {
        "star_rating": {
          "authoritative": true,
          "ui_locked": true
        }
      }
    }
  ],
  "global_field_rules": {
    "charge_types": {
      "source": "PMS",
      "authoritative": true,
      "ui_locked": true,
      "notes": "Operational reference data. Never editable."
    },
    "payment_types": {
      "source": "PMS",
      "authoritative": true,
      "ui_locked": true,
      "notes": "Operational reference data. Never editable."
    },
    "check_in_out_times": {
      "source": "PMS_if_available_else_admin",
      "authoritative_when_present": true,
      "ui_locked_when_pms": true,
      "notes": "Never overwritten without explicit refresh."
    },
    "star_rating": {
      "source": "seed_only",
      "authoritative": false,
      "ui_locked": false,
      "notes": "Only authoritative for selected PMS (Cloudbeds, Little Hotelier)."
    },
    "property_capacity": {
      "source": "PMS_seed_or_admin",
      "authoritative": false,
      "notes": "Never auto-derived from room data."
    },
    "house_rules": {
      "source": "admin_only",
      "authoritative": false,
      "notes": "PMS data ignored due to inconsistency."
    },
    "offerings": {
      "source": "admin_only",
      "authoritative": false,
      "notes": "Marketing/editorial only."
    },
    "collections": {
      "source": "admin_only",
      "authoritative": false,
      "notes": "Multi-brand website collections. Managed entirely in admin. Never sourced from PMS."
    },
    "multi_unit_config": {
      "source": "admin_only",
      "authoritative": false,
      "notes": "Hotel-style multi-unit auto-assignment config. Admin-managed, independent of PMS."
    },
    "portfolio_group": {
      "source": "admin_only",
      "authoritative": false,
      "notes": "Portfolio grouping for consolidated reporting. No PMS equivalent."
    }
  },
  "changelog": [
    "v1.2: Added collections field (multi-brand) as admin_only",
    "v1.2: Added multi_unit_config field (auto-assignment) as admin_only",
    "v1.2: Added portfolio_group field (multi-property groups) as admin_only",
    "v1.1: Added explicit rules for charge_types and payment_types",
    "v1.1: Clarified handling of check-in/check-out times",
    "v1.1: Defined star_rating as seed-only with PMS exceptions (Cloudbeds, Little Hotelier)",
    "v1.1: Clarified property-level capacity behavior",
    "v1.1: Explicitly excluded house_rules and offerings from PMS sync",
    "v1.1: Added per-PMS overrides support for global field rules"
  ]
}
