{
  "description": "Complete list of fields available when loading/creating a property in RoomsOnline",
  "version": "1.0",
  "lastUpdated": "2025-12-03",
  "sections": {
    "core": {
      "description": "Core property identification fields",
      "fields": {
        "id": { "type": "uuid", "required": false, "autoGenerated": true },
        "name": { "type": "string", "required": true, "pmsPopulated": true },
        "slug": { "type": "string", "required": false, "autoGenerated": true },
        "description": { "type": "text", "required": false, "pmsPopulated": true },
        "property_type": { "type": "enum", "required": true, "options": ["Hotel", "Guest House", "B&B", "Lodge", "Resort", "Villa", "Apartment"] },
        "property_url": { "type": "string", "required": false }
      }
    },
    "location": {
      "description": "Property location and address fields",
      "fields": {
        "address": { "type": "string", "required": true, "pmsPopulated": true },
        "city": { "type": "string", "required": true, "pmsPopulated": true },
        "country": { "type": "string", "required": true, "pmsPopulated": true },
        "latitude": { "type": "number", "required": false, "pmsPopulated": true },
        "longitude": { "type": "number", "required": false, "pmsPopulated": true }
      }
    },
    "capacity": {
      "description": "Property capacity and room count fields",
      "fields": {
        "bedrooms": { "type": "integer", "required": false, "default": 1, "pmsPopulated": true },
        "bathrooms": { "type": "integer", "required": false, "default": 1, "pmsPopulated": true },
        "max_guests": { "type": "integer", "required": true, "default": 2, "pmsPopulated": true }
      }
    },
    "pricing": {
      "description": "Base pricing fields",
      "fields": {
        "price_per_night": { "type": "decimal", "required": true }
      }
    },
    "ownership": {
      "description": "Property ownership fields",
      "fields": {
        "owner_name": { "type": "string", "required": false },
        "owner_email": { "type": "string", "required": false }
      }
    },
    "pmsIntegration": {
      "description": "PMS integration and external system fields",
      "fields": {
        "external_system": { "type": "enum", "required": false, "options": ["benson", "nightsbridge", "checkfront", "semper", "siteminder", "mews", "opera"] },
        "external_id": { "type": "string", "required": false },
        "benson_property_code": { "type": "string", "required": false, "conditionalOn": "external_system=benson" },
        "checkfront_property_code": { "type": "string", "required": false, "conditionalOn": "external_system=checkfront" },
        "siteminder_property_code": { "type": "string", "required": false, "conditionalOn": "external_system=siteminder" }
      }
    },
    "status": {
      "description": "Property status fields",
      "fields": {
        "is_active": { "type": "boolean", "required": false, "default": true },
        "permanently_deleted_at": { "type": "timestamp", "required": false }
      }
    },
    "timestamps": {
      "description": "Audit timestamp fields",
      "fields": {
        "created_at": { "type": "timestamp", "required": false, "autoGenerated": true },
        "updated_at": { "type": "timestamp", "required": false, "autoGenerated": true }
      }
    },
    "images": {
      "description": "Property images stored as JSON array",
      "fields": {
        "images": {
          "type": "json_array",
          "required": false,
          "default": [],
          "itemStructure": {
            "url": { "type": "string", "required": true },
            "caption": { "type": "string", "required": false },
            "order": { "type": "integer", "required": false }
          }
        }
      }
    },
    "amenities": {
      "description": "Property amenities and configuration stored as JSON object",
      "fields": {
        "amenities": {
          "type": "json_object",
          "required": false,
          "default": {},
          "structure": {
            "star_rating": { "type": "number", "min": 0, "max": 5, "pmsPopulated": true },
            "check_in_from": { "type": "string", "format": "HH:mm", "pmsPopulated": true },
            "check_in_to": { "type": "string", "format": "HH:mm", "pmsPopulated": true },
            "check_out_from": { "type": "string", "format": "HH:mm", "pmsPopulated": true },
            "check_out_to": { "type": "string", "format": "HH:mm", "pmsPopulated": true },
            "postal_code": { "type": "string", "pmsPopulated": true },
            "vat_number": { "type": "string" },
            "has_vat": { "type": "boolean" },
            "registration_number": { "type": "string" },
            "banking_details": { "type": "string" },
            "meal_types": { "type": "string_array", "examples": ["Breakfast", "Dinner", "Full Board", "Self-Catering"] },
            "facilities": {
              "type": "object",
              "fields": {
                "wifi": { "type": "boolean" },
                "parking": { "type": "boolean" },
                "pool": { "type": "boolean" },
                "gym": { "type": "boolean" },
                "spa": { "type": "boolean" },
                "restaurant": { "type": "boolean" },
                "bar": { "type": "boolean" },
                "room_service": { "type": "boolean" },
                "laundry": { "type": "boolean" },
                "airport_shuttle": { "type": "boolean" },
                "business_center": { "type": "boolean" },
                "conference_facilities": { "type": "boolean" },
                "pet_friendly": { "type": "boolean" },
                "wheelchair_accessible": { "type": "boolean" },
                "garden": { "type": "boolean" },
                "bbq": { "type": "boolean" },
                "fireplace": { "type": "boolean" },
                "hot_tub": { "type": "boolean" },
                "sauna": { "type": "boolean" },
                "tennis_court": { "type": "boolean" },
                "golf_course": { "type": "boolean" },
                "beach_access": { "type": "boolean" },
                "water_sports": { "type": "boolean" },
                "kids_club": { "type": "boolean" },
                "playground": { "type": "boolean" }
              }
            },
            "house_rules": {
              "type": "object",
              "fields": {
                "smoking_allowed": { "type": "boolean" },
                "pets_allowed": { "type": "boolean" },
                "parties_allowed": { "type": "boolean" },
                "quiet_hours_start": { "type": "string", "format": "HH:mm" },
                "quiet_hours_end": { "type": "string", "format": "HH:mm" },
                "additional_rules": { "type": "string_array" }
              }
            },
            "offerings": {
              "type": "object",
              "fields": {
                "accommodation": { "type": "boolean" },
                "events_weddings": { "type": "boolean" },
                "conference": { "type": "boolean" }
              }
            },
            "room_types": {
              "type": "array",
              "itemStructure": {
                "id": { "type": "string", "required": true },
                "name": { "type": "string", "required": true, "pmsPopulated": true },
                "url": { "type": "string" },
                "numRooms": { "type": "integer" },
                "pmsRoomType": { "type": "string", "pmsPopulated": true },
                "pmsRoomId": { "type": "string", "pmsPopulated": true },
                "description": { "type": "text" },
                "bedConfiguration": { "type": "string" },
                "roomSize": { "type": "string" },
                "bathrooms": { "type": "integer" },
                "maxPeople": { "type": "integer", "pmsPopulated": true },
                "maxAdults": { "type": "integer", "pmsPopulated": true },
                "maxChildren": { "type": "integer", "pmsPopulated": true },
                "minStay": { "type": "integer" },
                "maxStay": { "type": "integer" },
                "rateType": { "type": "string", "pmsPopulated": true },
                "splitPercent": { "type": "number" },
                "images": { "type": "string_array" },
                "facilities": {
                  "type": "object",
                  "fields": {
                    "air_conditioning": { "type": "boolean" },
                    "heating": { "type": "boolean" },
                    "tv": { "type": "boolean" },
                    "safe": { "type": "boolean" },
                    "minibar": { "type": "boolean" },
                    "coffee_maker": { "type": "boolean" },
                    "hair_dryer": { "type": "boolean" },
                    "iron": { "type": "boolean" },
                    "desk": { "type": "boolean" },
                    "balcony": { "type": "boolean" },
                    "sea_view": { "type": "boolean" },
                    "mountain_view": { "type": "boolean" },
                    "garden_view": { "type": "boolean" },
                    "pool_view": { "type": "boolean" },
                    "private_bathroom": { "type": "boolean" },
                    "bathtub": { "type": "boolean" },
                    "shower": { "type": "boolean" },
                    "kitchenette": { "type": "boolean" },
                    "washing_machine": { "type": "boolean" },
                    "fireplace": { "type": "boolean" }
                  }
                },
                "amenities": {
                  "type": "object",
                  "fields": {
                    "toiletries": { "type": "boolean" },
                    "towels": { "type": "boolean" },
                    "linens": { "type": "boolean" },
                    "slippers": { "type": "boolean" },
                    "bathrobes": { "type": "boolean" },
                    "welcome_drinks": { "type": "boolean" },
                    "fruit_basket": { "type": "boolean" },
                    "bottled_water": { "type": "boolean" }
                  }
                },
                "rate_info": {
                  "type": "array",
                  "itemStructure": {
                    "id": { "type": "string" },
                    "name": { "type": "string", "pmsPopulated": true },
                    "pmsRateId": { "type": "string", "pmsPopulated": true },
                    "baseRate": { "type": "number" },
                    "mealTypes": { "type": "string_array" }
                  }
                }
              }
            },
            "charge_types": {
              "type": "array",
              "pmsPopulated": true,
              "itemStructure": {
                "id": { "type": "string" },
                "name": { "type": "string" },
                "pmsChargeId": { "type": "string" }
              }
            },
            "payment_types": {
              "type": "array",
              "pmsPopulated": true,
              "itemStructure": {
                "id": { "type": "string" },
                "name": { "type": "string" },
                "pmsPaymentId": { "type": "string" }
              }
            }
          }
        }
      }
    }
  },
  "pmsFieldMapping": {
    "description": "Fields populated by each PMS system",
    "systems": {
      "benson": ["name", "room_types", "rate_types", "charge_types", "payment_types", "availability", "rates"],
      "nightsbridge": ["name", "description", "property_type", "address", "city", "country", "postal_code", "latitude", "longitude", "bedrooms", "bathrooms", "max_guests", "star_rating", "room_types", "rate_types", "availability", "rates", "images", "amenities", "facilities", "check_in_from", "check_in_to", "check_out_from", "check_out_to"],
      "checkfront": ["name", "description", "room_types", "availability", "rates"],
      "semper": ["name", "room_types", "rate_types", "availability", "rates", "charge_types"],
      "siteminder": ["name", "room_types", "rate_types", "availability", "rates"],
      "mews": ["name", "description", "room_types", "rate_types", "availability", "rates", "facilities"],
      "opera": ["name", "description", "room_types", "rate_types", "availability", "rates", "guest_info"]
    }
  }
}
